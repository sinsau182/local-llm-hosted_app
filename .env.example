COMPOSE_PROJECT_NAME=ai-inference-platform
POSTGRES_DB=platform
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=platform_password
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000
CADDY_PORT=443
MEDIA_ROOT=./data/media

# ── Feature toggles (master config — see .env) ──
# Frontend (NEXT_PUBLIC_*) are build-time: rebuild frontend after changing.
NEXT_PUBLIC_FEATURE_CHAT_PAGE=false
NEXT_PUBLIC_FEATURE_DASHBOARD_TAB=false
# Backend (FEATURE_*) are runtime: restart api after changing.
FEATURE_MEDIA_QUEUE=true
FEATURE_DOC_RAG=true
