APP_NAME=ai-inference-platform-api
APP_ENV=dev
API_PREFIX=/api/v1
JWT_PRIVATE_KEY=replace_with_private_key
JWT_PUBLIC_KEY=replace_with_public_key
JWT_ALGORITHM=RS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
DATABASE_URL=postgresql+psycopg://platform_user:platform_password@postgres:5432/platform
REDIS_URL=redis://redis:6379/0
MEDIA_ROOT=/data/media
MAX_STORAGE_BYTES=322122547200
MAX_REQUEST_TIMEOUT_SECONDS=600
